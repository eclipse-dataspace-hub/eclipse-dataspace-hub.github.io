---
/**
 * Component landscape for the landing page.
 *
 * A layered board of the services and functions in a dataspace solution.
 * Selecting a box shows what it does and links to related Eclipse projects,
 * specifications, and learning material.
 *
 * Internal links are written relative to the site root (no leading slash)
 * and resolved against the configured base path.
 *
 * Every link opens in a new tab, so the reader keeps the board and the
 * selected box while following a link.
 */
interface ResourceLink {
  label: string;
  href: string;
}

interface Service {
  key: string;
  kind: string;
  title: string;
  summary: string;
  description: string;
  links: ResourceLink[];
}

interface Layer {
  key: string;
  label: string;
  /** Rows of service keys. Each row is laid out in equal columns. */
  rows: string[][];
}

const services: Service[] = [
  {
    key: 'policies',
    kind: 'Governance function',
    title: 'Policy profiles',
    summary: 'Rules, trust, and participation',
    description:
      'Sets how organizations take part and share data. The dataspace decides on membership, roles, trusted issuers, required credentials, and what its policies mean. Software applies these decisions. It does not make them.',
    links: [
      { label: 'Trust, credentials, and profiles learning path', href: 'trust-and-profiles/' },
      { label: 'Onboarding', href: 'trust-and-profiles/05-onboarding/' },
      {
        label: 'IDSA Rulebook',
        href: 'https://kb.internationaldataspaces.org/external/rulebook/001_Introduction/',
      },
    ],
  },
  {
    key: 'issuer',
    kind: 'Trust service',
    title: 'Credential Issuer',
    summary: 'Credential issuance and lifecycle',
    description:
      'Issues verifiable credentials to approved participants. It signs and delivers them, and handles renewal and revocation.',
    links: [
      { label: 'Credentials and the issuer', href: 'platform-setup/08-credentials-and-the-issuer/' },
      {
        label: 'Identity Hub repository, including Issuer Service',
        href: 'https://github.com/eclipse-edc/IdentityHub',
      },
      {
        label: 'Decentralized Claims Protocol',
        href: 'https://eclipse-dataspace-dcp.github.io/decentralized-claims-protocol/',
      },
    ],
  },
  {
    key: 'applications',
    kind: 'Application function',
    title: 'Business and use-case applications',
    summary: 'Workflows and system integration',
    description:
      'The business systems and tools that provide or use the data. They own the business context and the workflow. This layer is also the data plane: once an agreement exists, the application, or a data plane it uses, serves or transfers the data.',
    links: [
      { label: 'Build a dataspace application learning path', href: 'application/' },
      { label: 'Data plane architecture', href: 'application/09-data-plane-architecture/' },
      { label: 'Eclipse Data Plane projects', href: 'https://github.com/eclipse-dataplane-core' },
      {
        label: 'Data Plane Signaling',
        href: 'https://github.com/eclipse-dataplane-signaling/dataplane-signaling',
      },
    ],
  },
  {
    key: 'credential',
    kind: 'Participant service',
    title: 'Credential Service',
    summary: 'Credentials and presentations',
    description:
      'Holds a participant’s identifiers, keys, and credentials, and presents them to other participants as proof. In EDC this is the Identity Hub, often called an organizational wallet.',
    links: [
      { label: 'Credentials and claims', href: 'application/13-credentials-and-claims/' },
      { label: 'Eclipse EDC Identity Hub', href: 'https://github.com/eclipse-edc/IdentityHub' },
      {
        label: 'Decentralized Claims Protocol',
        href: 'https://eclipse-dataspace-dcp.github.io/decentralized-claims-protocol/',
      },
    ],
  },
  {
    key: 'control',
    kind: 'Data-sharing service',
    title: 'Connector',
    summary: 'Offers, agreements, and orchestration',
    description:
      'Publishes and finds data offers, checks policies, negotiates agreements, and coordinates transfers. The business data itself does not pass through it.',
    links: [
      { label: 'Eclipse EDC Connector', href: 'https://github.com/eclipse-edc/Connector' },
      {
        label: 'Dataspace Protocol',
        href: 'https://eclipse-dataspace-protocol-base.github.io/DataspaceProtocol/',
      },
    ],
  },
  {
    key: 'platform',
    kind: 'Platform function',
    title: 'Shared platform services',
    summary: 'Provisioning, security, and operations',
    description:
      'The services needed to run the layers above: provisioning, security, networking, storage, secrets, and monitoring. This is not one central platform for the whole dataspace. Every participant can run these services itself, or use a managed version from a cloud service provider. Connector Fabric Manager helps a provider set up many participants automatically.',
    links: [
      { label: 'Set up a dataspace platform learning path', href: 'platform-setup/' },
      { label: 'Eclipse Connector Fabric Manager', href: 'https://github.com/eclipse-cfm/cfm' },
      {
        label: 'Eclipse Core Platform Distribution',
        href: 'https://github.com/eclipse-cfm/core-platform-distribution',
      },
    ],
  },
];

const layers: Layer[] = [
  {
    key: 'governance',
    label: 'Overall dataspace governance',
    rows: [['policies'], ['issuer']],
  },
  { key: 'applications', label: 'Application layer (data plane)', rows: [['applications']] },
  {
    key: 'core',
    label: 'Core participant services (control plane)',
    rows: [['credential', 'control']],
  },
  { key: 'platform', label: 'Platform services', rows: [['platform']] },
];

/** Shown until the reader selects another box, so the detail panel is never empty. */
const initialKey = 'control';

const byKey = new Map(services.map((service) => [service.key, service]));
/** Functions are drawn shaded, services as plain boxes. */
const isFunction = (service: Service) => service.kind.endsWith('function');
const isExternal = (href: string) => /^[a-z][a-z0-9+.-]*:/i.test(href);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolve = (href: string) => (isExternal(href) ? href : `${base}/${href.replace(/^\//, '')}`);
---

<service-landscape class="service-landscape not-content">
  <div class="landscape-layout">
    <figure class="landscape-figure" aria-label="Component landscape">
      <div class="landscape-board" role="group" aria-label="Dataspace service layers">
        {
          layers.map((layer) => (
            <section
              class:list={['landscape-layer', `landscape-layer--${layer.key}`]}
              aria-labelledby={`landscape-layer-${layer.key}`}
            >
              <p class="layer-label" id={`landscape-layer-${layer.key}`}>
                {layer.label}
              </p>
              {layer.rows.map((row) => (
                <div class="layer-row" style={`--columns: ${row.length}`}>
                  {row.map((key) => {
                    const service = byKey.get(key)!;
                    return (
                      <button
                        type="button"
                        class:list={['service-card', { 'service-card--function': isFunction(service) }]}
                        id={`service-button-${service.key}`}
                        data-service-key={service.key}
                        aria-controls={`service-detail-${service.key}`}
                        aria-expanded={service.key === initialKey ? 'true' : 'false'}
                        data-selected={service.key === initialKey ? '' : undefined}
                      >
                        <strong>{service.title}</strong>
                        <span>{service.summary}</span>
                        <span class="selection-marker" aria-hidden="true" />
                      </button>
                    );
                  })}
                </div>
              ))}
            </section>
          ))
        }
      </div>
    </figure>

    <div class="detail-home" data-detail-home></div>
    <div class="landscape-detail" data-landscape-detail aria-live="polite">
      {
        services.map((service) => (
          <section
            class="detail-panel"
            id={`service-detail-${service.key}`}
            data-detail-key={service.key}
            aria-labelledby={`service-button-${service.key}`}
            hidden={service.key !== initialKey}
          >
            <p class="detail-kind">{service.kind}</p>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <div class="detail-links">
              <strong>Projects and guidance</strong>
              <ul role="list">
                {service.links.map((link) => (
                  <li>
                    <a href={resolve(link.href)} target="_blank" rel="noopener noreferrer">
                      {link.label}
                      <span aria-hidden="true">{'\u2197\uFE0E'}</span>
                      <span class="sr-only">(opens in a new tab)</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        ))
      }
    </div>
  </div>
</service-landscape>

<script>
  /**
   * Shows the detail panel for the selected service. On narrow layouts the
   * panel moves directly below the selected box so the reader does not have
   * to scroll past the whole board.
   */
  class ServiceLandscape extends HTMLElement {
    private buttons: HTMLButtonElement[] = [];
    private panels: HTMLElement[] = [];
    private detail: HTMLElement | null = null;
    private detailHome: HTMLElement | null = null;
    private activeButton: HTMLButtonElement | null = null;
    private resizeObserver: ResizeObserver | null = null;

    connectedCallback() {
      if (this.dataset.ready === 'true') return;
      this.dataset.ready = 'true';
      this.buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-service-key]'));
      this.panels = Array.from(this.querySelectorAll<HTMLElement>('[data-detail-key]'));
      this.detail = this.querySelector<HTMLElement>('[data-landscape-detail]');
      this.detailHome = this.querySelector<HTMLElement>('[data-detail-home]');
      this.addEventListener('click', this.handleClick);
      this.resizeObserver = new ResizeObserver(() => this.placeDetail());
      this.resizeObserver.observe(this);
    }

    disconnectedCallback() {
      this.removeEventListener('click', this.handleClick);
      this.resizeObserver?.disconnect();
      this.dataset.ready = 'false';
    }

    private handleClick = (event: Event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const button = target.closest('[data-service-key]');
      if (button instanceof HTMLButtonElement && this.contains(button)) this.selectService(button);
    };

    private selectService(button: HTMLButtonElement) {
      const key = button.dataset.serviceKey;
      if (!key) return;
      this.activeButton = button;
      for (const candidate of this.buttons) {
        const selected = candidate === button;
        candidate.setAttribute('aria-expanded', String(selected));
        candidate.toggleAttribute('data-selected', selected);
      }
      for (const panel of this.panels) panel.hidden = panel.dataset.detailKey !== key;
      this.placeDetail();
    }

    private placeDetail() {
      if (!this.detail || !this.detailHome) return;
      const narrow = this.getBoundingClientRect().width <= 640;
      if (narrow && this.activeButton) {
        const row = this.activeButton.closest('.layer-row') ?? this.activeButton;
        if (this.detail.previousElementSibling !== row) row.after(this.detail);
        return;
      }
      if (this.detail.previousElementSibling !== this.detailHome) this.detailHome.after(this.detail);
    }
  }

  if (!customElements.get('service-landscape')) {
    customElements.define('service-landscape', ServiceLandscape);
  }
</script>

<style>
  .service-landscape {
    display: block;
    container-type: inline-size;
    margin-block: 1.35rem 1.85rem;
  }

  .landscape-layout {
    display: grid;
    gap: 0.8rem;
  }

  .landscape-figure {
    margin: 0;
  }

  /* Board */
  .landscape-board {
    display: grid;
    gap: 0.75rem;
    padding: clamp(0.75rem, 2cqw, 1rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
  }

  .landscape-layer {
    display: grid;
    gap: 0.5rem;
    padding: 0.55rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--sl-color-bg) 70%, transparent);
  }

  .layer-label {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .layer-row {
    display: grid;
    grid-template-columns: repeat(var(--columns, 1), minmax(0, 1fr));
    gap: 0.55rem;
  }

  .service-card {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.2rem;
    min-width: 0;
    min-height: 5.25rem;
    padding: 0.8rem 0.65rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.4rem;
    color: inherit;
    font: inherit;
    text-align: center;
    background: var(--sl-color-bg);
    cursor: pointer;
  }

  .service-card--function {
    background: var(--sl-color-gray-6);
  }

  .service-card strong {
    color: var(--sl-color-white);
    font-size: 0.88rem;
    line-height: 1.25;
  }

  .service-card > span:not(.selection-marker) {
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  /* A dot in the brand violet marks the selected box. */
  .selection-marker {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--hub-violet, var(--sl-color-accent));
    opacity: 0;
  }

  .service-card:hover {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-gray-6);
  }

  .service-card:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .service-card[data-selected] {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    box-shadow: inset 0 0 0 1px var(--sl-color-accent);
  }

  .service-card[data-selected] .selection-marker {
    opacity: 1;
  }

  /* Detail panel */
  .detail-home {
    display: none;
  }

  .landscape-detail {
    min-height: 9.5rem;
    padding: clamp(0.9rem, 2.5cqw, 1.25rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-nav);
  }

  .detail-panel[hidden] {
    display: none;
  }

  .detail-kind {
    margin: 0 0 0.2rem;
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .detail-panel h3 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .detail-panel > p:not(.detail-kind) {
    max-width: 68ch;
    margin: 0.45rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .detail-links {
    margin-top: 0.9rem;
  }

  .detail-links > strong {
    color: var(--sl-color-white);
    font-size: 0.75rem;
    line-height: 1.3;
  }

  .detail-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .detail-links a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.38rem 0.55rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.35rem;
    color: var(--sl-color-text-accent);
    font-size: 0.74rem;
    font-weight: 600;
    line-height: 1.35;
    text-decoration: none;
    background: var(--sl-color-bg);
  }

  .detail-links a:hover {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-gray-6);
  }

  .detail-links a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .service-card,
    .detail-links a {
      transition:
        border-color 120ms ease,
        background-color 120ms ease,
        box-shadow 120ms ease;
    }

    .selection-marker {
      transition: opacity 120ms ease;
    }
  }

  /* Wide: board and detail side by side. */
  @container (min-width: 58rem) {
    .landscape-layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: stretch;
      gap: 1rem;
    }

    .landscape-figure {
      display: grid;
    }
  }

  /* Narrow: one box per row, detail opens below the selected box. */
  @container (max-width: 40rem) {
    .layer-row {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: 0;
      padding: 0.85rem 2.4rem 0.85rem 0.85rem;
      place-content: initial;
      justify-items: start;
      text-align: left;
    }

    .landscape-detail {
      min-height: 0;
    }
  }

  @media (forced-colors: active) {
    .service-card:hover,
    .service-card:focus-visible,
    .service-card[data-selected],
    .detail-links a:hover,
    .detail-links a:focus-visible {
      border-color: Highlight;
      outline-color: Highlight;
    }

    .service-card[data-selected] {
      box-shadow: inset 0 0 0 1px Highlight;
    }
  }
</style>
