---
/**
 * A linked card that routes the reader to a learning path, a page, or an
 * external project. Place inside <RouteGrid>.
 *
 * `href` values that start with a scheme (https://…) are treated as external
 * and open in a new tab. Everything else is resolved against the site base
 * path, so pass paths without a leading slash, for example `use-case/`.
 */
interface Props {
  href: string;
  title: string;
  /** Small label above the title, for example the audience or the kind of resource. */
  kicker?: string;
  /** Call-to-action text shown at the bottom of the card. */
  cta?: string;
  compact?: boolean;
}

const { href, title, kicker, cta, compact = false } = Astro.props;

const external = /^[a-z][a-z0-9+.-]*:/i.test(href);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = external ? href : `${base}/${href.replace(/^\//, '')}`;
---

<li class="route-card-item">
  <a
    class:list={['route-card', { 'route-card--compact': compact }]}
    href={url}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    {kicker && <small>{kicker}</small>}
    <h3 class="route-card__title">{title}</h3>
    <div class="route-card__body"><slot /></div>
    {
      cta && (
        <span class="route-card__cta">
          {cta}
          <span class="route-card__arrow" aria-hidden="true">
            {external ? '\u2197\uFE0E' : '\u2192\uFE0E'}
          </span>
          {external && <span class="sr-only">(opens in a new tab)</span>}
        </span>
      )
    }
  </a>
</li>

<style>
  .route-card-item {
    min-width: 0;
  }

  .route-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    min-height: 100%;
    padding: 1.1rem 1.15rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    color: inherit;
    text-decoration: none;
    background: var(--sl-color-bg-nav);
  }

  .route-card--compact {
    padding: 0.85rem 0.95rem 0.8rem;
  }

  .route-card--compact .route-card__title {
    font-size: 0.92rem;
  }

  .route-card--compact .route-card__cta {
    padding-top: 0.4rem;
  }

  .route-card:hover,
  .route-card:focus-visible {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-gray-6);
  }

  .route-card:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .route-card small {
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .route-card__title {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 0.98rem;
    line-height: 1.3;
  }

  .route-card__body,
  .route-card__body :global(p) {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .route-card__cta {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.55rem;
    color: var(--sl-color-text-accent);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: no-preference) {
    .route-card {
      transition:
        border-color 120ms ease,
        background-color 120ms ease;
    }

    .route-card__arrow {
      transition: transform 120ms ease;
    }

    .route-card:hover .route-card__arrow,
    .route-card:focus-visible .route-card__arrow {
      transform: translateX(0.18rem);
    }
  }

  @media (forced-colors: active) {
    .route-card:hover,
    .route-card:focus-visible {
      border-color: Highlight;
      outline-color: Highlight;
    }
  }
</style>
