---
/**
 * Message sequence between a few parties.
 *
 *   <Sequence
 *     actors={{ a: 'Consumer', b: 'Provider' }}
 *     steps={[
 *       { from: 'a', to: 'b', label: 'Catalog request' },
 *       { at: 'b', label: 'Checks the credentials' },
 *       { from: 'b', to: 'a', label: 'Catalog' },
 *     ]}
 *     caption="…"
 *   />
 *
 * A step with `from` and `to` is a message. A step with `at` is something one
 * party does by itself. On narrow screens the lanes collapse into a list.
 */
type Step = { from: string; to: string; label: string } | { at: string; label: string };

interface Props {
  actors: Record<string, string>;
  steps: Step[];
  caption?: string;
}

const { actors, steps, caption } = Astro.props;
const keys = Object.keys(actors);
const column = (key: string) => {
  const index = keys.indexOf(key);
  if (index < 0) throw new Error(`Sequence: unknown actor "${key}"`);
  return index + 1;
};
---

<figure class="hub-figure not-content sequence" style={`--actors: ${keys.length}`}>
  <div class="head" aria-hidden="true">
    {keys.map((key) => <div class="hub-node actor"><strong>{actors[key]}</strong></div>)}
  </div>
  <ol role="list">
    {
      steps.map((step, index) => {
        const lanes = keys.map(() => <span class="lane" aria-hidden="true" />);
        if ('at' in step) {
          return (
            <li class="step">
              {lanes}
              <div
                class:list={[
                  'note',
                  { 'note--first': column(step.at) === 1, 'note--last': column(step.at) === keys.length },
                ]}
                style={`grid-column: ${column(step.at)}`}
              >
                <span class="route">{actors[step.at]}</span>
                <span class="text">
                  <b>{index + 1}</b>
                  {step.label}
                </span>
              </div>
            </li>
          );
        }
        const from = column(step.from);
        const to = column(step.to);
        const start = Math.min(from, to);
        const span = Math.abs(to - from) + 1;
        return (
          <li class="step">
            {lanes}
            <div class="message" style={`grid-column: ${start} / span ${span}; --span: ${span}`}>
              <span class="route">
                {actors[step.from]} → {actors[step.to]}
              </span>
              <span class="text">
                <b>{index + 1}</b>
                {step.label}
              </span>
              <span class:list={['hub-arrow', { 'hub-arrow--back': to < from }]} aria-hidden="true" />
            </div>
          </li>
        );
      })
    }
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .head,
  .step {
    display: grid;
    grid-template-columns: repeat(var(--actors), minmax(0, 1fr));
  }

  .head {
    gap: 0.5rem;
  }

  .actor {
    justify-items: center;
    text-align: center;
  }

  ol {
    margin: 0;
    padding: 0.35rem 0 0.2rem;
    list-style: none;
  }

  .step {
    align-items: center;
    min-height: 3rem;
  }

  /* Lifelines */
  .lane {
    grid-row: 1;
    align-self: stretch;
    justify-self: center;
    width: 0;
    border-inline-start: 1px dashed var(--sl-color-gray-4);
  }

  .lane:nth-child(1) { grid-column: 1; }
  .lane:nth-child(2) { grid-column: 2; }
  .lane:nth-child(3) { grid-column: 3; }
  .lane:nth-child(4) { grid-column: 4; }
  .lane:nth-child(5) { grid-column: 5; }

  .message,
  .note {
    grid-row: 1;
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding-block: 0.45rem;
  }

  /* A message runs from the middle of one lane to the middle of another. */
  .message {
    padding-inline: calc(50% / var(--span));
    text-align: center;
  }

  .text {
    justify-self: center;
    padding-inline: 0.4rem;
    color: var(--sl-color-gray-1);
    font-size: 0.78rem;
    line-height: 1.3;
    background: var(--sl-color-bg-nav);
  }

  .text b {
    display: inline-grid;
    place-items: center;
    width: 1.2rem;
    height: 1.2rem;
    margin-inline-end: 0.35rem;
    border-radius: 999px;
    color: var(--sl-color-text-invert);
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1;
    background: var(--sl-color-accent);
    vertical-align: 0.05em;
  }

  :root[data-theme='light'] .text b {
    color: #fff;
  }

  .note {
    justify-self: center;
    width: max-content;
    /* Never wider than the space between the two neighbouring lifelines. */
    max-width: min(17rem, 96cqw, calc(200% - 1.2rem));
    padding: 0.4rem 0.6rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: 0.4rem;
    text-align: center;
    background: var(--sl-color-bg);
  }

  /* At the outer lanes a note keeps to its own lane, so it never covers the lifeline next to it. */
  .note--first,
  .note--last {
    max-width: calc(100% - 0.5rem);
  }

  .note .text {
    padding: 0;
    color: var(--sl-color-gray-2);
    background: none;
  }

  .route {
    display: none;
  }

  /* Narrow: a numbered list that names sender and receiver in words. */
  @container (max-width: 34rem) {
    .head,
    .lane,
    .message .hub-arrow {
      display: none;
    }

    ol {
      display: grid;
      gap: 0.45rem;
      padding: 0;
    }

    .step {
      display: block;
      min-height: 0;
    }

    .message,
    .note {
      justify-self: stretch;
      width: auto;
      max-width: none;
      margin: 0;
      padding: 0.55rem 0.7rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.4rem;
      text-align: start;
      background: var(--sl-color-bg);
    }

    .note {
      border-style: dashed;
    }

    .route {
      display: block;
      color: var(--sl-color-gray-3);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      line-height: 1.3;
    }

    .text {
      justify-self: start;
      padding: 0;
      background: none;
    }
  }
</style>
