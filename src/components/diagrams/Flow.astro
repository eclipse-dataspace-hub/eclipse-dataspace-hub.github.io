---
/**
 * Who does what, top to bottom.
 *
 *   <Flow
 *     steps={[
 *       { actor: 'Governance authority', text: 'decides rules and admission' },
 *       { actor: 'Issuer', text: 'signs credentials for admitted members' },
 *       { actor: 'Platform operator', text: 'runs the software', apart: true },
 *     ]}
 *     caption="…"
 *   />
 *
 * Steps are joined by arrows. A step marked `apart` stands beside the chain
 * and is drawn without an arrow.
 */
interface Step {
  actor: string;
  text: string;
  apart?: boolean;
}

interface Props {
  steps: Step[];
  caption?: string;
}

const { steps, caption } = Astro.props;
---

<figure class="hub-figure not-content flow">
  <ol role="list">
    {
      steps.map((step, index) => (
        <li class:list={{ apart: step.apart }}>
          {index > 0 && !step.apart && <span class="hub-arrow hub-arrow--down" aria-hidden="true" />}
          <div class="hub-node step">
            <strong>{step.actor}</strong>
            <span>{step.text}</span>
          </div>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  ol {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: 0.3rem;
    padding-top: 0.3rem;
  }

  li:first-child {
    padding-top: 0;
  }

  .hub-arrow--down {
    margin-inline: 1.6rem 0;
  }

  .step {
    grid-template-columns: minmax(9rem, 14rem) minmax(0, 1fr);
    align-items: baseline;
    column-gap: 1rem;
    border-inline-start: 0.2rem solid var(--sl-color-accent);
  }

  .step span {
    font-size: 0.8rem;
  }

  .apart {
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--sl-color-gray-4);
  }

  .apart .step {
    border-inline-start-color: var(--sl-color-gray-4);
    border-style: dashed;
    border-inline-start-style: solid;
  }

  @container (max-width: 30rem) {
    .step {
      grid-template-columns: 1fr;
    }
  }
</style>
