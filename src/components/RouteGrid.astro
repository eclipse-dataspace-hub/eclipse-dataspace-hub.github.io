---
/**
 * Responsive grid for RouteCard items.
 * Uses container queries so it adapts to the content column, not the viewport.
 */
interface Props {
  columns?: 2 | 3 | 4;
}

const { columns = 2 } = Astro.props;
---

<div class="route-grid-wrap not-content">
  <ul class:list={['route-grid', `route-grid--${columns}`]} role="list">
    <slot />
  </ul>
</div>

<style>
  .route-grid-wrap {
    container-type: inline-size;
    margin-block: 1.15rem 1.45rem;
  }

  .route-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @container (min-width: 34rem) {
    .route-grid--2,
    .route-grid--3,
    .route-grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @container (min-width: 52rem) {
    .route-grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @container (min-width: 60rem) {
    .route-grid--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
